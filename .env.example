# Backend / database (server-side only; never expose via VITE_*)
POSTGRES_DB=terra
POSTGRES_USER=terra
POSTGRES_PASSWORD=terra_local_only
DATABASE_URL=postgresql://terra:terra_local_only@localhost:5432/terra
# Comma-separated allowed browser origins ("*" is ignored on purpose)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
