# Frontend (Vite). VITE_* values are bundled into the browser: NEVER put secrets, DB URLs or keys here.
# Local dev: leave empty to use the Vite proxy (/api -> http://localhost:8000), or set explicitly (needs CORS_ALLOWED_ORIGINS on the API):
VITE_API_BASE_URL=http://localhost:8000
# Production (Vercel project setting): VITE_API_BASE_URL=https://<deployed-backend-domain>
